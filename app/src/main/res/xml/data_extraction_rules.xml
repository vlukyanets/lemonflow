<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup="false" turns off cloud backup, but on Android 12+ device-to-device transfer
  still runs unless excluded here. User data leaves the device only through the app's own
  encrypted export (constitution, principle II).
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
    <exclude domain="device_root" />
    <exclude domain="device_file" />
    <exclude domain="device_database" />
    <exclude domain="device_sharedpref" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
    <exclude domain="device_root" />
    <exclude domain="device_file" />
    <exclude domain="device_database" />
    <exclude domain="device_sharedpref" />
  </device-transfer>
</data-extraction-rules>
